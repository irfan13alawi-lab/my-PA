[Unit]
Description=IRFAN OS static dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/irfan-os-dashboard
ExecStart=/usr/bin/python3 -m http.server 18086 --bind 0.0.0.0 --directory /home/ubuntu/irfan-os-dashboard
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
