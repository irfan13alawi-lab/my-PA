[Unit]
Description=IRFAN OS dashboard API and web app
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/irfan-os-dashboard
ExecStart=/usr/bin/node /home/ubuntu/irfan-os-dashboard/server/server.js
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/irfan-os-dashboard/server/data
Environment=NODE_ENV=production
Environment=PORT=18086
EnvironmentFile=-/etc/irfan-os-dashboard.env

[Install]
WantedBy=multi-user.target
